# Data is downloaded from Kaggle, never committed
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Trained model artifacts: only the small files the API needs are committed
models/*
!models/.gitkeep
!models/lightgbm.txt
!models/preprocessor.joblib
!models/api_config.json

# Secrets and local settings
.env

# Python
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/

# Generated deployment bundles
build/
